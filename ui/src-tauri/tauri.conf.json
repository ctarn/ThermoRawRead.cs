{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThermoRawRead",
  "version": "1.5.0",
  "identifier": "io.ctarn.thermorawread",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ThermoRawRead",
        "width": 1320,
        "height": 900,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../tmp/ui/icons/32x32.png",
      "../../tmp/ui/icons/128x128.png",
      "../../tmp/ui/icons/128x128@2x.png",
      "../../tmp/ui/icons/icon.icns",
      "../../tmp/ui/icons/icon.ico"
    ]
  }
}
